# InboxIQ backend — environment configuration
# Copy to .env and fill in values.

# Gemini API key (only needed for the "gemini" extraction engine).
# Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model candidates (comma-separated, tried in order).
GEMINI_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash

# SQLAlchemy database URL.
DATABASE_URL=sqlite:///./inboxiq.db

# Sentence-transformer model used for semantic dedup / engine comparison.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Cosine similarity threshold above which two tasks are treated as duplicates.
DEDUP_THRESHOLD=0.82

# CORS: comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
